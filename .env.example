# microCMS のサービスドメイン（https://<ここ>.microcms.io の部分）
MICROCMS_SERVICE_DOMAIN=your-service-domain

# microCMS の コンテンツ API キー（読み取り権限）
MICROCMS_API_KEY=your-api-key

# 公開サイトのオリジン（SNS 共有・コピー用の絶対 URL に使う。末尾スラッシュ無し）
# 未設定時は Vercel の環境変数、それも無ければ http://localhost:3000 に落ちる
NEXT_PUBLIC_SITE_URL=https://example.com
